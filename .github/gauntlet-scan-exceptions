#!/usr/bin/env python3
# Written by the gauntlet (arm-gauntlet.ts) and regenerated by --upgrade. To
# change what is excepted, edit .gauntlet.json, not this file.
# Usage: gauntlet-scan-exceptions <osv|semgrep|checkov|trivy> <out dir> <report|quiet>
import json, os, re, sys
scanner, out, mode = sys.argv[1:4]
CFG = ".gauntlet.json"
KNOWN = ["osv", "semgrep", "checkov", "trivy"]
SEG = re.compile(r"[A-Za-z0-9._@+-]+")
CHECK = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]*")
def shown(v):
    return json.dumps(v, ensure_ascii=False, separators=(",", ":"))
def norm(p):
    if not isinstance(p, str):
        return None
    s = p[2:] if p.startswith("./") else p
    s = s.rstrip("/")
    if not s or not all(SEG.fullmatch(g) and g not in (".", "..") for g in s.split("/")):
        return None
    return s
def parse(raw):
    if not isinstance(raw, dict) or "exceptions" not in raw:
        return [], []
    items = raw["exceptions"]
    if not isinstance(items, list):
        return [], ["exceptions is not a list of { paths, scanners, reason } entries"]
    good, bad = [], []
    for i, e in enumerate(items):
        if not isinstance(e, dict):
            bad.append("exceptions[%d] is not an object" % i)
            continue
        probs = []
        reason = e.get("reason").strip() if isinstance(e.get("reason"), str) else ""
        if not reason:
            probs.append("it has no reason, and an exception nobody can review is a hole")
        paths = []
        if not isinstance(e.get("paths"), list) or not e["paths"]:
            probs.append("it names no paths")
        else:
            for p in e["paths"]:
                n = norm(p)
                if n is None:
                    probs.append("path %s is not a plain repo-relative path (no globs, no .., no leading /)" % shown(p))
                else:
                    paths.append(n)
        scanners = []
        if not isinstance(e.get("scanners"), list) or not e["scanners"]:
            probs.append("it names no scanners")
        else:
            for s in e["scanners"]:
                if isinstance(s, str) and s in KNOWN:
                    scanners.append(s)
                else:
                    probs.append("unknown scanner %s (known: %s)" % (shown(s), ", ".join(KNOWN)))
        checks = None
        if "checks" in e:
            c = e["checks"]
            if not isinstance(c, list) or not c or not all(isinstance(x, str) and CHECK.fullmatch(x) for x in c):
                probs.append("checks is not a list of check IDs")
            else:
                checks = c
                others = [s for s in scanners if s != "trivy"]
                if others:
                    probs.append("checks can only be scoped for trivy; %s cannot skip one check in one path" % ", ".join(others))
        if probs:
            bad.append("exceptions[%d] refused: %s" % (i, "; ".join(probs)))
            continue
        good.append({"paths": paths, "scanners": scanners, "reason": reason, "checks": checks})
    return good, bad
def kind(p):
    return "file" if os.path.isfile(p) else "dir" if os.path.isdir(p) else "missing"
good, bad = [], []
if os.path.exists(CFG):
    try:
        with open(CFG, encoding="utf-8") as f:
            raw = json.load(f)
    except ValueError:
        bad = [CFG + " is not valid JSON, so none of its exceptions apply"]
    else:
        good, bad = parse(raw)
args, excluded, summary, dirs, files, ignores = [], [], [], [], [], []
warnings = ["SCAN EXCEPTION REFUSED: " + b for b in bad]
for e in good:
    if scanner not in e["scanners"]:
        continue
    why = " ".join(e["reason"].split())
    for p in e["paths"]:
        k = kind(p)
        head = "SCAN EXCEPTION %s: %s" % (scanner, p)
        if k == "missing":
            warnings.append(head + " does not exist, so this exception excepts nothing; remove it from " + CFG)
            continue
        if e["checks"] is not None:
            target = p + "/**" if k == "dir" else p
            for c in e["checks"]:
                ignores.append("  - id: %s\n    paths:\n      - %s\n    statement: %s\n" % (json.dumps(c, ensure_ascii=False), json.dumps(target, ensure_ascii=False), json.dumps(why, ensure_ascii=False)))
            summary.append("%s is still scanned, but %s is not reported there (reason: %s)" % (head, ", ".join(e["checks"]), why))
            continue
        if scanner == "osv":
            if k == "file":
                warnings.append(head + " is a file, and osv-scanner can only skip directories, so it is still scanned")
                continue
            args.append("--experimental-exclude=" + p)
        elif scanner == "semgrep":
            args.append("--exclude=/" + p)
        elif scanner == "checkov":
            args += ["--skip-path", "^" + re.sub(r"([.+])", r"\\\1", p) + "(/|$)"]
        elif k == "dir":
            args += ["--skip-dirs", p]
            dirs.append(p)
        else:
            args += ["--skip-files", p]
            files.append(p)
        excluded.append(p)
        summary.append(head + " is not scanned (reason: " + why + ")")
for name, items in (("args", args), ("excluded", excluded)):
    with open(os.path.join(out, name), "w", encoding="utf-8") as f:
        f.write("".join(x + "\n" for x in items))
ignorefile = ""
if ignores:
    ignorefile = os.path.join(out, "trivyignore.yaml")
    with open(ignorefile, "w", encoding="utf-8") as f:
        f.write("misconfigurations:\n" + "".join(ignores))
if mode == "report":
    if os.environ.get("GITHUB_STEP_SUMMARY"):
        with open(os.environ["GITHUB_STEP_SUMMARY"], "a", encoding="utf-8") as f:
            f.write("".join(x + "\n" for x in warnings + summary))
    for x in warnings:
        print("::warning title=scan exception::" + x.replace("%", "%25"))
    for x in summary:
        print("::notice title=scan exception::" + x.replace("%", "%25"))
    if scanner == "trivy" and os.environ.get("GITHUB_OUTPUT"):
        with open(os.environ["GITHUB_OUTPUT"], "a", encoding="utf-8") as f:
            f.write("skip_dirs=%s\nskip_files=%s\ntrivyignores=%s\n" % (",".join(dirs), ",".join(files), ignorefile))
