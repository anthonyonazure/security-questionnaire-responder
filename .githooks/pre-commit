#!/usr/bin/env sh
# Quality gauntlet — blocks the commit if any gate fails. Your gate when there is no CI.
set -e
echo "· gauntlet: stack check"
ruff check . && ruff format --check .
echo "· gauntlet: secret scan"
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
else
  echo "  (gitleaks not installed locally — CI still enforces it)"
fi
echo "OK gauntlet passed"
